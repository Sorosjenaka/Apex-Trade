# =====================================================================
# Apex Trade (Rust) — TEMPLATE ENVIRONMENT (TANPA RAHASIA)
# Engine Rust membaca kredensial HANYA dari environment proses (tidak
# memuat file .env secara otomatis demi keamanan).
# JANGAN PERNAH meng-commit kunci API asli ke repositori Git.
# =====================================================================

# ---------- BINANCE USDT-M FUTURES ----------
# Gunakan izin Read + Futures Trade saja (TANPA izin Withdraw).
# Tidak diperlukan untuk mode default `paper` (simulasi lokal).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---------- PENGAMAN EKSEKUSI NYATA (LIVE) ----------
# Mode LIVE membutuhkan KETIGA syarat secara bersamaan:
#   1) `arm = true` di `config/engine.toml` (diubah manual oleh operator)
#   2) `--mode live` pada CLI `apex run`
#   3) `APEX_LIVE_CONFIRM=I_UNDERSTAND_LIVE_ORDERS`
APEX_LIVE_CONFIRM=

# ---------- DASHBOARD & TERMINAL WEB ----------
APEX_DASH_PORT=8787
APEX_FAPI_BAN_SECS=0

# ---------- OPSIONAL: DATA PETA LIKUIDASI EKSTERNAL ----------
# Kosongkan untuk memakai estimasi peta likuidasi struktural bawaan Rust.
VIKE_API_KEY=
